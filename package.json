{
  "name": "create-next-pro",
  "version": "1.0.0",
  "description": "CLI tool to scaffold Next.js projects with best practices and built-in mock API server",
  "main": "dist/index.js",
  "bin": {
    "create-next-pro": "./bin/create-next-pro.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nextjs",
    "cli",
    "scaffold",
    "mock-api",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "fs-extra": "^11.3.5",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
